# Copy to .env (ignored by Git) and set a strong password before the first start.
# The database is only reachable from the app container, but keep the password private.
# Use single quotes: Compose treats $ in an unquoted value as a variable reference.
POSTGRES_PASSWORD='change-me'
# Optional NAS overrides.
ELECTRIC_IMAGE=ghcr.io/wjdecorte/electric-dashboard:latest
# Pin a published build for a controlled rollout/rollback:
# ELECTRIC_IMAGE=ghcr.io/wjdecorte/electric-dashboard:sha-FULL_COMMIT_SHA
